#%%

feature_columns = continuous_feature_columns + binary_feature_columns

MINIMUM_BLOCK_ADJUSTMENT = 0.25

def calculate_block_adjustment(shots):
    """Return a smooth multiplier from 0.25 to 1 based on block distance."""
    adjustment = pd.Series(1.0, index=shots.index)
    close_block = shots['isBlockedWithin3Yards'].fillna(False).astype(bool)
    normalized_distance = (
        pd.to_numeric(shots['blockedDistanceYards'], errors='coerce') / 3
    ).clip(lower=0, upper=1)
    adjustment.loc[close_block] = (
        MINIMUM_BLOCK_ADJUSTMENT
        + (1 - MINIMUM_BLOCK_ADJUSTMENT) * normalized_distance.loc[close_block]
    )
    return adjustment

#%%

shot_df['isGoal'] = shot_df['isGoal'].fillna(False).astype(int)

#%%

shot_df[binary_feature_columns] = (
    shot_df[binary_feature_columns].fillna(False).astype(bool).astype(int)
)

# %%

# Train an xG model and evaluate it on matches the model has not seen.

X = shot_df[feature_columns].copy()
X[continuous_feature_columns] = X[continuous_feature_columns].apply(
    pd.to_numeric, errors='coerce'
)
# Qualifiers are present as True and absent as NaN in the source data.
X[binary_feature_columns] = (
    X[binary_feature_columns].fillna(False).astype(bool).astype(int)
)
y = shot_df['isGoal'].fillna(False).astype(int)
groups = shot_df['match_id']

splitter = GroupShuffleSplit(n_splits=1, test_size=0.20, random_state=42)
train_indices, test_indices = next(splitter.split(X, y, groups=groups))
X_train = X.iloc[train_indices]
X_test = X.iloc[test_indices]
y_train = y.iloc[train_indices]
y_test = y.iloc[test_indices]

preprocessor = ColumnTransformer(
    transformers=[
        ('continuous', Pipeline([
            ('imputer', SimpleImputer(strategy='median')),
            ('scaler', StandardScaler()),
        ]), continuous_feature_columns),
        ('binary', SimpleImputer(strategy='constant', fill_value=0),
         binary_feature_columns),
    ],
    remainder='drop',
)

xg_model = Pipeline([
    ('preprocessor', preprocessor),
    ('classifier', HistGradientBoostingClassifier(
        max_iter=180,
        learning_rate=0.04,
        max_leaf_nodes=8,
        min_samples_leaf=10,
        l2_regularization=3,
        random_state=42,
    )),
])

def predict_xg(model, features, penalty_rate, goalkeeper_dribbled_rate):
    """Predict regular shots and apply learned rates to distinct shot classes."""
    probabilities = model.predict_proba(features)[:, 1]
    penalties = features['Penalty'].eq(1).to_numpy()
    goalkeeper_dribbled = features['isGoalkeeperDribbled'].eq(1).to_numpy()
    probabilities[penalties] = penalty_rate
    probabilities[goalkeeper_dribbled & ~penalties] = goalkeeper_dribbled_rate
    return probabilities

train_penalty_mask = X_train['Penalty'].eq(1)
train_goalkeeper_dribbled_mask = X_train['isGoalkeeperDribbled'].eq(1)
training_penalty_rate = y_train.loc[train_penalty_mask].mean()
training_goalkeeper_dribbled_rate = y_train.loc[
    train_goalkeeper_dribbled_mask
].mean()
train_regular_shot_mask = ~(
    train_penalty_mask | train_goalkeeper_dribbled_mask
)
xg_model.fit(
    X_train.loc[train_regular_shot_mask],
    y_train.loc[train_regular_shot_mask],
)

test_base_xg = predict_xg(
    xg_model,
    X_test,
    training_penalty_rate,
    training_goalkeeper_dribbled_rate,
)
test_block_adjustment = calculate_block_adjustment(
    shot_df.iloc[test_indices]
).to_numpy()
test_xg = test_base_xg * test_block_adjustment
test_predictions = (test_xg >= 0.5).astype(int)

calibration_table = pd.DataFrame({
    'actual': y_test,
    'predicted': test_xg,
})
calibration_table['decile'] = pd.qcut(
    calibration_table['predicted'], q=10, duplicates='drop'
)
calibration_table = calibration_table.groupby(
    'decile', observed=True
).agg(
    shots=('actual', 'size'),
    mean_xg=('predicted', 'mean'),
    goal_rate=('actual', 'mean'),
)
mean_calibration_error = (
    (calibration_table['mean_xg'] - calibration_table['goal_rate']).abs()
    * calibration_table['shots']
).sum() / calibration_table['shots'].sum()

model_metrics = {
    'roc_auc': roc_auc_score(y_test, test_xg),
    'log_loss': log_loss(y_test, test_xg),
    'brier_score': brier_score_loss(y_test, test_xg),
    'accuracy': accuracy_score(y_test, test_predictions),
    'precision': precision_score(y_test, test_predictions, zero_division=0),
    'recall': recall_score(y_test, test_predictions, zero_division=0),
    'mean_calibration_error': mean_calibration_error,
}

print('\nHoldout model metrics')
for metric_name, metric_value in model_metrics.items():
    print(f'{metric_name}: {metric_value:.4f}')
print('confusion_matrix:')
print(confusion_matrix(y_test, test_predictions))
print('calibration_by_xG_decile:')
print(calibration_table)

penalty_mask = X['Penalty'].eq(1)
goalkeeper_model_mask = X['isGoalkeeperDribbled'].eq(1)
penalty_conversion_rate = y.loc[penalty_mask].mean()
goalkeeper_dribbled_conversion_rate = y.loc[goalkeeper_model_mask].mean()
regular_shot_mask = ~(penalty_mask | goalkeeper_model_mask)
# Fit ordinary shots separately from penalties and goalkeeper-dribbled chances.
xg_model.fit(X.loc[regular_shot_mask], y.loc[regular_shot_mask])
shot_df['baseXG'] = predict_xg(
    xg_model,
    X,
    penalty_conversion_rate,
    goalkeeper_dribbled_conversion_rate,
)
shot_df['blockAdjustment'] = calculate_block_adjustment(shot_df)
shot_df['xG'] = shot_df['baseXG'] * shot_df['blockAdjustment']

goalkeeper_counterfactual_features = X.loc[goalkeeper_model_mask].copy()
goalkeeper_counterfactual_features['isGoalkeeperDribbled'] = 0
goalkeeper_counterfactual_xg = predict_xg(
    xg_model,
    goalkeeper_counterfactual_features,
    penalty_conversion_rate,
    goalkeeper_dribbled_conversion_rate,
)
goalkeeper_dribble_xg_lift = (
    shot_df.loc[goalkeeper_model_mask, 'baseXG'].to_numpy()
    - goalkeeper_counterfactual_xg
).mean()

penalty_mean_xg = shot_df.loc[penalty_mask, 'xG'].mean()
