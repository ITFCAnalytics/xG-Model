# create a new column to indicate if the shot was taken with either foot

shot_df = shot_df.copy()
shot_df['isFooted'] = (
    shot_df['LeftFoot'].fillna(False).astype(bool)
    | shot_df['RightFoot'].fillna(False).astype(bool)
