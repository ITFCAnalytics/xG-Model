# calculate the distance in yards from the shot location to the centre of the goal
distance_to_goal_line_yards = (
    (100 - shot_df['x']) / 100 * PITCH_LENGTH_YARDS
)
distance_to_goal_centre_yards = (
    (50 - shot_df['y']) / 100 * PITCH_WIDTH_YARDS
)
shot_df['distanceToGoal'] = (
    distance_to_goal_line_yards ** 2 + distance_to_goal_centre_yards ** 2
) ** 0.5

# calculate the angle of the shot from the shot location to the goal

def calculate_goal_angle(row):
    """Return the angle in radians between the shot location and the goalposts."""
    if pd.isna(row['x']) or pd.isna(row['y']):
        return float('nan')

    distance_to_goal_line = (100 - row['x']) / 100 * PITCH_LENGTH_YARDS
    shot_y = row['y'] / 100 * PITCH_WIDTH_YARDS
    goal_centre_y = PITCH_WIDTH_YARDS / 2
    half_goal_width = GOAL_WIDTH_YARDS / 2

    left_post = (distance_to_goal_line, goal_centre_y - half_goal_width - shot_y)
    right_post = (distance_to_goal_line, goal_centre_y + half_goal_width - shot_y)
    cross_product = abs(
        left_post[0] * right_post[1] - left_post[1] * right_post[0]
    )
    dot_product = (
        left_post[0] * right_post[0] + left_post[1] * right_post[1]
    )
    return math.atan2(cross_product, dot_product)

shot_df['goalAngle'] = shot_df.apply(calculate_goal_angle, axis=1)

# calculate the distance from the shot location to the blocked location

x_to_block_yards = (
    (shot_df['blockedX'] - shot_df['x']) / 100 * PITCH_LENGTH_YARDS
)
y_to_block_yards = (
    (shot_df['blockedY'] - shot_df['y']) / 100 * PITCH_WIDTH_YARDS
)
distance_to_block_yards = (x_to_block_yards ** 2 + y_to_block_yards ** 2) ** 0.5

is_blocked = shot_df['Blocked'].fillna(False).astype(bool)
shot_df['isBlockedWithin3Yards'] = (
