assert goalkeeper_model_mask.sum() > 0
assert goalkeeper_dribble_xg_lift > 0
assert set(groups.iloc[train_indices]).isdisjoint(set(groups.iloc[test_indices]))
assert model_metrics['roc_auc'] > 0.5
assert model_metrics['brier_score'] < y_test.mean() * (1 - y_test.mean())
assert abs(penalty_mean_xg - penalty_conversion_rate) < 1e-12

print('\nModel tests passed')
